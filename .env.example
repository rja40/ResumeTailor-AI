# Provider selection: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# OpenAI  (also works for any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Leave empty for the official OpenAI API.
# For OpenRouter:   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                   OPENAI_MODEL=openai/gpt-4o-mini  (or anthropic/claude-haiku-4.5, etc.)
OPENAI_BASE_URL=

# Generation settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192

# UI theme — choose one: terminal | minimal | workspace | wizard
UI_THEME=terminal
